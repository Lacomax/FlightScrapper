# FlightScrapper Environment Variables
# Copia este archivo a .env y rellena con tus credenciales

# ============================================
# KIWI.COM API (https://tequila.kiwi.com)
# ============================================
KIWI_API_KEY=tu_api_key_aqui

# ============================================
# SKYSCANNER API via RapidAPI
# (https://rapidapi.com/skyscanner/api/skyscanner-flight-search)
# ============================================
RAPID_API_KEY=tu_rapid_api_key_aqui

# ============================================
# AMADEUS API (https://developers.amadeus.com)
# ============================================
AMADEUS_CLIENT_ID=tu_client_id_aqui
AMADEUS_CLIENT_SECRET=tu_client_secret_aqui

# ============================================
# PROXY SETTINGS (Opcional)
# ============================================
# Use proxies for web scraping to avoid IP bans
USE_PROXIES=false
PROXY_ROTATION_INTERVAL=10

# ============================================
# DRIVER SETTINGS
# ============================================
# Browser headless mode (recomendado: true)
HEADLESS_MODE=true

# Timeout en segundos para cargar páginas
SELENIUM_TIMEOUT=60

# Delay máximo entre peticiones (segundos)
REQUEST_DELAY_MAX=5
REQUEST_DELAY_MIN=1

# ============================================
# OUTPUT SETTINGS
# ============================================
# Archivo de salida para resultados
OUTPUT_FILE=resultados_vuelos.json

# Máximo de resultados a mostrar
MAX_RESULTS=20

# ============================================
# LOGGING
# ============================================
# Nivel de logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Archivo de log
LOG_FILE=flight_scraper.log
